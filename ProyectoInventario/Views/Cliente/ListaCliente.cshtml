@model List<ProyectoInventario.Models.Cliente>


@{
    ViewBag.Title = "ListaCliente";
}

<link href="~/Content/style.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<h2>ListaCliente</h2>


<div class="card">

    <h3>Nuevo Cliente</h3>

    <form action="/Cliente/AgregarCliente" method="post" class="form-horizontal">



        <div class="form-group-item">
            <label>Nombre Cliente</label>
            <input type="text" name="NombreCliente" class="form-control-inline" placeholder="Ingrese" required />

        </div>
        <div class="form-group-item">

            <label>Apellido</label>
            <input type="text" name="ApellidoCliente" class="form-control-inline" placeholder="Ingrese" required />

        </div>
        <div class="form-group-item">
            <label>Telefono</label>
            <input type="text" name="Telefono" class="form-control-inline" placeholder="Ingrese" required />

        </div>
        <div class="form-group-button">
            <button type="submit" class="btn-agregar-inline">AGREGAR</button>

        </div>
    </form>

</div>


<div class="card">


    <table class="custom-table">

        <tr>
            <th>ID</th>
            <th>Nombre Cliente</th>
            <th>Apellido Cliente</th>
            <th>Telefono</th>
            <th>Accion</th>

        </tr>

        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>

                        <td>@item.IdCliente</td>
                        <td>@item.NombreCliente</td>
                        <td>@item.ApellidoCliente</td>
                        <td>@item.Telefono</td>
                        <td class="actions-cell">

                         
                            <a href="javascript:void(0);"
                               class="btn-action edit btn-editar"
                               title="Editar"
                               data-id="@item.IdCliente"
                               data-nombre="@item.NombreCliente"
                               data-apellido="@item.ApellidoCliente"
                               data-telefono="@item.Telefono">
                                <i class="fa-solid fa-pencil"></i>
                            </a>

                            <a href="/Cliente//EliminarCliente/@item.IdCliente" class="btn-action btn-eliminar" title="Eliminar" onclick="return confirm('Seguro deseas eliminar?');"><i class="fa-solid fa-trash-can"></i></a>
                        </td>

                    </tr>

                }
            }


        </tbody>



    </table>



</div>


<div class="modal fade" id="modalEditarCliente" tabindex="-1" role="dialog" aria-hidden="true" style="display:none; position: fixed; top: 20%; left: 35%; width: 30%; background: white; border: 1px solid #ccc; padding: 20px; box-shadow: 0px 4px 10px rgba(0,0,0,0.3); border-radius: 8px; z-index: 1050;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">
        <h4 style="margin: 0; color: #333;"><i class="fa-solid fa-pencil"></i> Editar Datos del Cliente</h4>
        <button type="button" onclick="cerrarModal()" style="background: none; border: none; font-size: 18px; cursor: pointer;">&times;</button>
    </div>

    <div>
     
        <input type="hidden" id="txtIdCliente" />

        <div style="margin-bottom: 12px;">
            <label style="display:block; margin-bottom:5px; font-weight:bold;">Nombre:</label>
            <input type="text" id="txtNombre" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 12px;">
            <label style="display:block; margin-bottom:5px; font-weight:bold;">Apellido:</label>
            <input type="text" id="txtApellido" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display:block; margin-bottom:5px; font-weight:bold;">Teléfono:</label>
            <input type="text" id="txtTelefono" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
    </div>

    <div style="text-align: right; border-top: 1px solid #eee; padding-top: 10px;">
        <button type="button" onclick="cerrarModal()" style="padding: 6px 12px; background: #999; color: white; border: none; border-radius: 4px; cursor: pointer;">Cancelar</button>
        <button type="button" id="btnGuardarCambios" style="padding: 6px 12px; background: #0275d8; color: white; border: none; border-radius: 4px; cursor: pointer;">Guardar Cambios</button>
    </div>
</div>


<div id="modalFondo" style="display:none; position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.5); z-index: 1040;"></div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {

      
        $(".btn-editar").on("click", function () {
            var id = $(this).data("id");
            var nombre = $(this).data("nombre");
            var apellido = $(this).data("apellido");
            var telefono = $(this).data("telefono");

            $("#txtIdCliente").val(id);
            $("#txtNombre").val(nombre);
            $("#txtApellido").val(apellido);
            $("#txtTelefono").val(telefono);

         
            $("#modalEditarCliente").show();
            $("#modalFondo").show();
        });

       
        $("#btnGuardarCambios").on("click", function () {
            var datosCliente = {
                IdCliente: $("#txtIdCliente").val(),
                NombreCliente: $("#txtNombre").val(),
                ApellidoCliente: $("#txtApellido").val(),
                Telefono: $("#txtTelefono").val() 
            };

            $.ajax({
                url: '@Url.Action("EditarCliente", "Cliente")',
                type: 'POST',
                data: datosCliente,
                success: function (response) {
                    if(response) {
                        cerrarModal();
                        location.reload(); 
                    }
                },
                error: function () {
                    alert("Error al guardar las modificaciones.");
                }
            });
        });
    });

    function cerrarModal() {
        $("#modalEditarCliente").hide();
        $("#modalFondo").hide();
    }
</script>

