@model List<ProyectoInventario.Models.Usuario>


@{
    ViewBag.Title = "ListaUsuario";
}

<link href="~/Content/style.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<h2>ListaUsuario</h2>

<div class="card">

    <h3>Nuevo Usuario</h3>

    <form action="/Usuario/AgregarUsuario" method="post" class="form-horizontal">
        <div class="form-group-item">
            <label> Usuario</label>
            <input type="text" name="User" class="form-control-inline" placeholder="Nombre" required />
            <label>Password</label>
            <input type="text" name="Password" class="form-control-inline" placeholder="Nombre" required />
        </div>

        <div class="form-group-item">
            <label>Rol</label>

            @Html.DropDownList(
           "IdRol",
           (List<SelectListItem>)ViewBag.Rol,
           "Selecione un Rol",
                new { @class = "form-control-inline" }
           )

        </div>
        <div class="form-group-button">
            <button type="submit" class="btn-agregar-inline">agregado</button>
        </div>

    </form>

</div>

<div class="card">
    <table class="custom-table">

        <tr>

            <td>ID</td>
            <td>Usuario</td>
            <td>Clave</td>
            <td>Rol</td>
            <td>Estado</td>
            <td>Accion</td>
        </tr>


        @if (Model != null)
        {
            foreach (var item in Model)
            {

                <tr>

                    <td>@item.IdUsuario</td>
                    <td>@item.User</td>
                    <td>@item.Password</td>
                    <td>@item.NombreRol</td>
                    <td>
                        @if (item.Activo == true)
                        {
                            <span class="badge active">Habilitado</span>
                        }
                        else
                        {
                            <span class="badge inactive">Deshabilitado</span>
                        }
                    </td>

                    <td class="actions-cell">

                        <a href="javascript:void(0);"
                           class="btn-action edit btn-editar"
                           title="Editar"
                           data-idusuario="@item.IdUsuario"
                           data-usuario="@item.User"
                           data-clave="@item.Password"
                           data-idrol="@item.IdRol">


                            <i class="fa-solid fa-pencil"></i>
                        </a>



                        <a href="/Usuario/EliminarUsuario/@item.IdUsuario" class="btn-action btn-eliminar" title="Eliminar" onclick="return confirm('Seguro deseas eliminar?');"><i class="fa-solid fa-trash-can"></i></a>

                        <a href="/Usuario/CambiarEstado/@item.IdUsuario" class="btn-action" style="color: #ffc107;" title="Cambiar Estado" onclick="return confirm('¿Seguro deseas cambiar el estado?');">
                            <i class="fa-solid @(item.Activo ? "fa-user-slash" : "fa-user-check")"></i>
                        </a>

                    </td>

                </tr>

            }
        }
    </table>


</div>


<div class="modal fade" id="modalEditarUsuario" tabindex="-1" role="dialog" aria-hidden="true" style="display:none; position: fixed; top: 20%; left: 35%; width: 30%; background: white; border: 1px solid #ccc; padding: 20px; box-shadow: 0px 4px 10px rgba(0,0,0,0.3); border-radius: 8px; z-index: 1050;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">
        <h4 style="margin: 0; color: #333;"><i class="fa-solid fa-pencil"></i> Editar Datos del Usuario</h4>
        <button type="button" onclick="cerrarModal()" style="background: none; border: none; font-size: 18px; cursor: pointer;">&times;</button>
    </div>

    <div>
       
        <input type="hidden" id="txtIdUsuario" />

        <div style="margin-bottom: 12px;">
            <label style="display:block; margin-bottom:5px; font-weight:bold;">Usuario:</label>
            <input type="text" id="txtUsuario" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 12px;">
            <label style="display:block; margin-bottom:5px; font-weight:bold;">Contraseña:</label>
            <input type="password" id="txtClave" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display:block; margin-bottom:5px; font-weight:bold;">Rol:</label>
            <select id="cboRol" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="">-- Seleccione un Rol --</option>
                @if (ViewBag.Rol != null)
                {
                    foreach (var item in (List<SelectListItem>)ViewBag.Rol)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }



            </select>
        </div>
    </div>

    <div style="text-align: right; border-top: 1px solid #eee; padding-top: 10px;">
        <button type="button" onclick="cerrarModal()" style="padding: 6px 12px; background: #999; color: white; border: none; border-radius: 4px; cursor: pointer;">Cancelar</button>
        <button type="button" id="btnGuardarCambios" style="padding: 6px 12px; background: #0275d8; color: white; border: none; border-radius: 4px; cursor: pointer;">Guardar Cambios</button>
    </div>
</div>

<div id="modalFondo" style="display:none; position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.5); z-index: 1040;"></div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>



    $(document).ready(function () {

      
        $(".btn-editar").on("click", function () {
            var idUsuario = $(this).data("idusuario");
            var usuario = $(this).data("usuario");
            var clave = $(this).data("clave");
            var idRol = $(this).data("idrol");

            $("#txtIdUsuario").val(idUsuario);
            $("#txtUsuario").val(usuario);
            $("#txtClave").val(clave);

         
            $("#cboRol").val(idRol);

            $("#modalEditarUsuario").show();
            $("#modalFondo").show();
        });

      
        $("#btnGuardarCambios").on("click", function () {
            var idRolSeleccionado = $("#cboRol").val();

       
            if (!idRolSeleccionado) {
                alert("Por favor seleccione un rol válido.");
                return;
            }

            var datosUsuario = {
                IdUsuario: $("#txtIdUsuario").val(),
                User: $("#txtUsuario").val(),
                Password: $("#txtClave").val(),
                IdRol: parseInt(idRolSeleccionado) 
            };

            $.ajax({
                url: '@Url.Action("EditarUsuario", "Usuario")',
                type: 'POST',
                data: datosUsuario,
                success: function (response) {
                    cerrarModal();
                    location.reload();
                },
                error: function () {
                    alert("Error al actualizar el usuario.");
                }
            });
        });
    });

    function cerrarModal() {
        $("#modalEditarUsuario").hide();
        $("#modalFondo").hide();
    }
</script>

